<!--
  Superposition en jeu : petite fenêtre transparente, toujours au-dessus du jeu, qui laisse passer les clics quand elle
  est verrouillée. Elle ne fait qu'afficher (README, règles 2 et 3) : rien n'est injecté ni dessiné dans le client.
-->
<Window x:Class="DofusRetroManager.Multi.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dofus Retro Manager — superposition" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FontFamily="{DynamicResource AppFont}" FontSize="12" Foreground="{DynamicResource Text}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <!-- Tête du personnage : rien tant que sa classe n'est pas connue -->
        <Style x:Key="HideWithoutSource" TargetType="Image">
            <Style.Triggers>
                <Trigger Property="Source" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentSolid}"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Card" Width="300" Padding="12,10" Margin="10" BorderThickness="1"
            CornerRadius="{DynamicResource RadiusLg}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel>
            <!-- Ordre de jeu (onglet Switcheur) : en haut, pour que les autres blocs ne le déplacent pas -->
            <StackPanel Visibility="{Binding ShowRotation, Converter={StaticResource Visible}}" Margin="0,0,0,6">
                <TextBlock Text="Ordre de jeu" Style="{StaticResource Section}" Margin="0,0,0,4"/>
                <ItemsControl x:Name="RotationList" ItemsSource="{Binding Rotation}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Turn_Click" ToolTip="Afficher sa fenêtre">
                            <!-- Mode split : c'est son tour, la ligne clignote -->
                            <Border x:Name="Glow" Background="{DynamicResource AccentSolid}" CornerRadius="4" Opacity="0" Margin="-3,0"/>
                            <DockPanel Margin="0,1">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Order}" Width="18" Foreground="{DynamicResource TextMuted}" FontWeight="Bold"/>
                                <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Initiative}" Foreground="{DynamicResource TextMuted}"
                                           Width="50" TextAlignment="Right" ToolTip="Initiative"/>
                                <!-- Points de vie en pourcentage -->
                                <Grid DockPanel.Dock="Right" Width="64" Height="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                      Visibility="{Binding HasLife, Converter={StaticResource Visible}}">
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding LifeValue, Mode=OneWay}" Height="12"
                                                 Background="{DynamicResource Surface2}" BorderThickness="0" Foreground="#C0392B"/>
                                    <TextBlock Text="{Binding LifeText}" FontSize="9.5" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- Temps du tour qui s'écoule -->
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Timer}" FontWeight="Bold" Margin="6,0,0,0"
                                           Foreground="{DynamicResource Warning}" ToolTip="Temps écoulé du tour / durée du tour"/>
                                <TextBlock x:Name="Name" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Active}" Value="True">
                                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource AccentSolid}"/>
                                    <Setter TargetName="Name" Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Blink}" Value="True">
                                    <Setter TargetName="Name" Property="FontWeight" Value="Bold"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                                 From="0.1" To="0.55" Duration="0:0:0.5"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <!-- Personnage affiché (celui de l'onglet Combat) -->
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,1,8,1"/>
                <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="30" Height="30" Margin="0,0,8,0" VerticalAlignment="Center"
                       Style="{StaticResource HideWithoutSource}"/>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Stats}" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
            <TextBlock x:Name="MoveHint" Text="Mode déplacement : faites glisser, puis cliquez « Verrouiller » dans l'onglet Switcheur."
                       TextWrapping="Wrap" Foreground="{DynamicResource Warning}" FontWeight="SemiBold" Margin="0,6,0,0" Visibility="Collapsed"/>

            <!-- Économe -->
            <StackPanel Visibility="{Binding ShowEconome, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding Econome}" Style="{StaticResource Section}" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding Spells}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="Tile" Width="30" Height="30" Margin="0,0,3,3">
                                <Image Source="{Binding Icon}"/>
                                <Border x:Name="Veil" Background="#99707070" Visibility="Collapsed"/>
                                <Border x:Name="Fail" BorderBrush="{DynamicResource Missing}" BorderThickness="2" Visibility="Collapsed"/>
                                <Border x:Name="Pick" BorderBrush="#FF34D399" BorderThickness="2" Visibility="Collapsed"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <!-- Borné : l'action à relancer, encadrée de vert -->
                                <DataTrigger Binding="{Binding State}" Value="2">
                                    <Setter TargetName="Pick" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="0">
                                    <Setter TargetName="Veil" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Tile" Property="Opacity" Value="0.55"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="-1">
                                    <Setter TargetName="Veil" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Fail" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Groupes de la map -->
            <StackPanel Visibility="{Binding ShowGroups, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding GroupsTitle}" Style="{StaticResource Section}"/>
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Box" CornerRadius="{DynamicResource RadiusSm}" Padding="7,4" Margin="0,0,0,3"
                                    Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Monsters}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Info}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Archi}" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Missing}"/>
                                    <Setter TargetName="Box" Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Récolte : ressources de la map, disponibles et récoltées -->
            <StackPanel Visibility="{Binding ShowHarvest, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding HarvestTitle}" Style="{StaticResource Section}"/>
                <!-- Icône de l'objet récolté, nombre disponible et repousse (pas de nom : la superposition laisse passer la souris) -->
                <ItemsControl ItemsSource="{Binding Harvest}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,3">
                                <Image Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,3,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Count}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding State}" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Forgemagie : objet en cours, dernières runes passées (la plus récente en haut) -->
            <TextBlock Text="{Binding FmTitle}" Style="{StaticResource Section}" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding ShowFm, Converter={StaticResource Visible}}"/>
            <!-- Reliquat en évidence -->
            <TextBlock Visibility="{Binding ShowFm, Converter={StaticResource Visible}}" Margin="0,0,0,4">
                <Run Text="Reliquat " Foreground="{DynamicResource TextMuted}"/><Run Text="{Binding FmReliquat, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentSolid}"/>
            </TextBlock>
            <!-- Forgemagie : chaque ligne, valeur / max et chance de succès (SC + SN) de ses runes (rouge : au-delà du max) -->
            <ItemsControl x:Name="FmChancesList" ItemsSource="{Binding FmChances}" Visibility="{Binding ShowFmChances, Converter={StaticResource Visible}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,2">
                            <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Val" DockPanel.Dock="Left" Text="{Binding Value}" Width="62" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <ItemsControl ItemsSource="{Binding Runes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,6,0" ToolTip="{Binding Tip}" Background="Transparent">
                                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,2,0"/>
                                            <TextBlock x:Name="Sc" Text="{Binding Sc}" Foreground="#2ECC71" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Over}" Value="True"><Setter TargetName="Sc" Property="Foreground" Value="#E74C3C"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Over}" Value="True"><Setter TargetName="Val" Property="Foreground" Value="#E74C3C"/></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding FmHistory}" Visibility="{Binding ShowFmHistory, Converter={StaticResource Visible}}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,2">
                            <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,4,0"/>
                            <Border x:Name="Badge" DockPanel.Dock="Left" CornerRadius="3" Padding="4,0" Margin="0,0,5,0" Background="#2ECC71" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Changes}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,5,0" ToolTip="{Binding Text}" Background="Transparent">
                                            <Image Source="{Binding Icon}" Width="14" Height="14" Margin="0,0,2,0"/>
                                            <TextBlock x:Name="Chg" Text="{Binding Value}" Foreground="#2ECC71" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Gain}" Value="False"><Setter TargetName="Chg" Property="Foreground" Value="#E74C3C"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Code}" Value="SN"><Setter TargetName="Badge" Property="Background" Value="#3B82F6"/></DataTrigger>
                            <DataTrigger Binding="{Binding Code}" Value="EC"><Setter TargetName="Badge" Property="Background" Value="#E74C3C"/></DataTrigger>
                            <DataTrigger Binding="{Binding Code}" Value="EC0"><Setter TargetName="Badge" Property="Background" Value="#B07070"/></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </Border>
</Window>
