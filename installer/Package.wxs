<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <!-- UpgradeCode : ne jamais le changer, il permet aux nouvelles versions de remplacer les anciennes -->
  <Package Name="Dofus Retro Manager"
           Manufacturer="Dofus Retro Manager"
           Version="!(bind.FileVersion.AppExe)"
           UpgradeCode="7727C9CD-4CAE-44A1-A2C5-2661DAF6E7C0"
           Language="1036"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="Une version plus récente de Dofus Retro Manager est déjà installée." />

    <!-- Mise à jour depuis « Dofus Bank Manager » (1.32 et avant) : son script de mise à jour relance l'ancien
         DofusBankManager.exe, qui n'existe plus. En installation sans assistant (/passive), c'est donc l'installateur
         qui lance la nouvelle application. -->
    <Upgrade Id="7727C9CD-4CAE-44A1-A2C5-2661DAF6E7C0">
      <UpgradeVersion Property="LEGACYBANKMANAGER" Maximum="1.33.0" IncludeMaximum="no" OnlyDetect="yes" />
    </Upgrade>
    <CustomAction Id="LaunchAfterLegacyUpdate" FileRef="AppExe" ExeCommand="--update-result=0"
                  Execute="immediate" Return="asyncNoWait" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="..\DofusRetroManager\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Recrox/DOFUS_RETRO_MANAGER" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/Recrox/DOFUS_RETRO_MANAGER/releases/latest" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Dofus Retro Manager">
        <Component Id="AppExe">
          <File Id="AppExe" Source="$(PayloadDir)\DofusRetroManager.exe" KeyPath="yes">
            <!-- Sans cette règle, Windows bloque le trafic entrant vers la capture (voir README).
                 Elle est retirée à la désinstallation. -->
            <fw:FirewallException Id="FirewallIn" Name="Dofus Retro Manager"
                                  Description="Lecture passive du trafic Dofus Retro (aucun port ouvert)"
                                  Scope="any" Profile="all" IgnoreFailure="yes" />
          </File>
        </Component>
        <Component Id="Readme">
          <File Id="Readme" Source="..\README.md" Name="LISEZMOI.md" KeyPath="yes" />
        </Component>
        <!-- Règles de développement, liées depuis le README -->
        <Component Id="Rules">
          <File Id="Rules" Source="..\REGLES.md" Name="REGLES.md" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Menu Démarrer : dossier « Dofus Retro Manager » avec l'application et sa désinstallation -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Dofus Retro Manager">
        <Component Id="StartMenuShortcuts">
          <Shortcut Id="StartMenuShortcut" Name="Dofus Retro Manager" Description="Banque et recettes Dofus Retro"
                    Target="[#AppExe]" WorkingDirectory="INSTALLFOLDER" />
          <Shortcut Id="UninstallShortcut" Name="Désinstaller Dofus Retro Manager" Description="Supprime Dofus Retro Manager"
                    Target="[System64Folder]msiexec.exe" Arguments="/x [ProductCode]" />
          <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\DofusRetroManager" Name="StartMenuShortcuts"
                         Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut">
        <Shortcut Id="DesktopShortcut" Name="Dofus Retro Manager" Description="Banque et recettes Dofus Retro"
                  Target="[#AppExe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\DofusRetroManager" Name="DesktopShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Désinstallation : l'application peut aussi avoir créé elle-même la règle de pare-feu
         (FirewallRule.cs). On supprime toute règle « Dofus Retro Manager » liée à cet exécutable.
         Pas lors d'une mise à jour : la nouvelle version recrée sa règle. -->
    <SetProperty Id="CleanFirewall" Sequence="execute" Before="CleanFirewall"
                 Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"
                 Value="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall delete rule name=&quot;Dofus Retro Manager&quot; program=&quot;[INSTALLFOLDER]DofusRetroManager.exe&quot;" />
    <CustomAction Id="CleanFirewall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="CleanFirewall" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="LaunchAfterLegacyUpdate" After="InstallFinalize" Condition="UILevel = 3 AND LEGACYBANKMANAGER AND NOT REMOVE" />
    </InstallExecuteSequence>

    <!-- Fin d'installation : case « Lancer Dofus Retro Manager », cochée par défaut -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Lancer Dofus Retro Manager" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#AppExe]" />
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" />

    <Feature Id="Main" Title="Dofus Retro Manager">
      <ComponentRef Id="AppExe" />
      <ComponentRef Id="Readme" />
      <ComponentRef Id="Rules" />
      <ComponentRef Id="StartMenuShortcuts" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Assistant : bienvenue, conditions d'utilisation, dossier d'installation, fin -->
    <UI>
      <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <WixVariable Id="WixUILicenseRtf" Value="Licence.rtf" />
  </Package>
</Wix>
